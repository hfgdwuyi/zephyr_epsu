/ {
    aliases {
        watchdog0 = &iwdg1;
    };

    chosen {
        zephyr,console = &lpuart1;
        zephyr,shell-uart = &lpuart1;
        zephyr,crc = &crc;
        zephyr,code-partition = &slot0_partition;
    };

    zephyr,user {
        io-channels =
            <&adc1 10>,  /* 0: PUMP-ADC (ADC1_INP10) */
            <&adc3 7>,   /* 1: FORCE-ADC(1) (ADC3_INP7) */
            <&adc3 13>,  /* 2: FORCE-ADC(2) (ADC3_INP13) */
            <&adc3 15>,  /* 3: FORCE-ADC(3) (ADC3_INP15) */
            <&adc1 1>,   /* 4: TEMP-FD-ADC (ADC1_INP1) */
            <&adc1 15>,  /* 5: TEMP-MB-ADC (ADC1_INP15) */
            <&adc1 12>,  /* 6: ADC1_INP12 */
            <&adc3 1>;   /* 7: ADC3_INP1 */

        dac = <&dac1>;
        dac_channel_id = <0>;     /* 0 => OUT1 in Zephyr STM32 DAC driver */
        dac_resolution = <12>;

        pwms =
            <&pwm12 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
    };

};

&iwdg1 {
    status = "okay";
};

&lpuart1 {
    status = "okay";
    current-speed = <115200>;
};


&adc1 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <1>;
};

&adc3 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <1>;
};

&dac1 {
    status = "okay";
};

/* MCUboot flash partitions (1MB M7 flash @ 0x08000000) */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(64)>;
            read-only;
        };

        slot0_partition: partition@10000 {
            label = "image-0";
            reg = <0x00010000 DT_SIZE_K(448)>;
        };

        slot1_partition: partition@80000 {
            label = "image-1";
            reg = <0x00080000 DT_SIZE_K(448)>;
        };

        storage_partition: partition@f0000 {
            label = "storage";
            reg = <0x000f0000 DT_SIZE_K(64)>;
        };
    };
};
