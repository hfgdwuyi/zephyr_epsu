/*
 * cioszhong_psu_stm32h745xx_m7.dts — CiosZhong ePSU controller, CM7 core
 *
 * Clock configuration:
 *   HSE = 25 MHz external clock on PH0 (OSC_25M, bypass mode).
 *   PLL1: div-m = 5, mul-n = 192, div-p = 2
 *     VCO_in  = 25/5 = 5 MHz     (H7 PLL input range 1-16 MHz)
 *     VCO     = 5*192 = 960 MHz  (within 192-960 MHz)
 *     PLL1P   = 960/2 = 480 MHz  = SYSCLK (unchanged from NUCLEO config)
 *     PLL1Q   = 960/8 = 120 MHz  (unchanged)
 *     PLL1R   = 960/2 = 480 MHz  (unchanged)
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <st/h7/stm32h745Xi_m7.dtsi>
#include "cioszhong_psu.dtsi"

/ {
	model = "Siemens CiosZhong ePSU controller board";
	compatible = "siemens,cioszhong-psu";

	/* HW resources belonging to CM7 */
	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,dtcm = &dtcm;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,canbus = &fdcan1;
	};

	aliases {
		led0 = &green_led;
	};
};

/*
 * TEMP BRING-UP: use the internal HSI (64 MHz) so the firmware no longer
 * depends on the external 25 MHz clock source on PH0. Set back to HSE
 * once the board is verified. (See git history for the HSE 25 MHz config.)
 */
&clk_hsi {
	status = "okay";
};

/* HSI48: the STM32 RNG kernel clock (RNGSEL defaults to HSI48). Without it
 * the entropy driver spins forever on the RNG DRDY bit during boot. */
&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	status = "disabled";
};

&pll {
	div-m = <8>;    /* HSI 64 MHz / 8 = 8 MHz VCO-in */
	mul-n = <120>;  /* VCO = 960 MHz */
	div-p = <2>;    /* SYSCLK = 480 MHz */
	div-q = <8>;    /* PLL1Q = 120 MHz */
	div-r = <2>;    /* PLL1R = 480 MHz */
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(480)>;
};

/* USART1 on PB14(TX)/PB15(RX) is the product debug/host UART.
 * USART3 is not used on this board (PB10/PB11 are ethernet signals). */
&usart1 {
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	status = "disabled";
};

/* I2C1 on PB8/PB9 (TMP75 temperature sensor @0x48) */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
};

/* I2C3 on PH7/PH8 (identity EEPROM M24512 @0x50, WP tied to GND) */
&i2c3 {
	pinctrl-0 = <&i2c3_scl_ph7 &i2c3_sda_ph8>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
};

/*
 * CAN per product pin_config.xlsx / 实测接线：
 *   CAN2: PB13 (can2_tx) / PB5  (can2_rx)   -> FDCAN2  ← 产品实际使用的这路
 *   CAN1: PH13 (can1_tx) / PH14 (can1_rx)   -> FDCAN1  ← 当前使用(zephyr,canbus)
 *
 * 注意：本板没有外部晶振（&clk_hse status = disabled），而 H7 的
 * D2CCIP1R.FDCANSEL 复位默认是 HSE → 控制器会拿不到内核时钟、
 * can_start() 返回 -EAGAIN。内核时钟切到 PLL1Q 的动作在
 * application/src/main/main.c 的 canopenInit() 里用 LL_RCC 完成
 * （Zephyr 的 H7 时钟驱动不会写这个 mux）。
 */
&fdcan1 {
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
	pinctrl-0 = <&fdcan1_rx_ph14 &fdcan1_tx_ph13>;
	pinctrl-names = "default";
	status = "okay";
};

/* CAN 活动指示灯（pin_config.xlsx：CAN1 = PH15/PH12，CAN2 = PH11/PH10）。
 * 固件在发送/接收时翻转它们，台架上可直观判断总线上到底有没有动作。
 * 用自定义 compatible（无需 LED 子系统驱动），驱动里用 GPIO_DT_SPEC_GET 取用。*/
/ {
	can_activity_leds {
		/* 用标准 gpio-leds binding，这样 gpios 会被正确解析成 phandle-array；
		 * 不需要打开 CONFIG_LED —— 驱动里直接用 GPIO_DT_SPEC_GET 手动翻转。*/
		compatible = "gpio-leds";

		can2_tx_led: can2_tx_led {
			gpios = <&gpioh 11 GPIO_ACTIVE_HIGH>;
		};

		can2_rx_led: can2_rx_led {
			gpios = <&gpioh 10 GPIO_ACTIVE_HIGH>;
		};

		can1_tx_led: can1_tx_led {
			gpios = <&gpioh 15 GPIO_ACTIVE_HIGH>;
		};

		can1_rx_led: can1_rx_led {
			gpios = <&gpioh 12 GPIO_ACTIVE_HIGH>;
		};
	};
};

&fdcan2 {
	/* 本板实际接线在 CAN1(PH13/PH14)；CAN2 保留但不启用 */
	status = "disabled";
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
	pinctrl-0 = <&fdcan2_rx_pb5 &fdcan2_tx_pb13>;
	pinctrl-names = "default";
};

/* ==================== Ethernet (RMII) ====================
 * RMII pins per pin_config.xlsx:
 *   PA1 ref_clk, PA2 mdio, PA7 crs_dv, PB10 rx_er, PC1 mdc,
 *   PC4 rxd0, PC5 rxd1, PG11 tx_en, PG12 txd1, PG13 txd0.
 * PHY: MDIO address 0 (to be confirmed against the schematic). */
&mac {
	status = "okay";
	pinctrl-0 = <&eth_ref_clk_pa1
		     &eth_crs_dv_pa7
		     &eth_rx_er_pb10
		     &eth_rxd0_pc4
		     &eth_rxd1_pc5
		     &eth_tx_en_pg11
		     &eth_txd0_pg13
		     &eth_txd1_pg12>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
	phy-handle = <&eth_phy>;
};

&mdio {
	status = "okay";
	pinctrl-0 = <&eth_mdio_pa2 &eth_mdc_pc1>;
	pinctrl-names = "default";

	eth_phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0x00>;
	};
};

/* RNG: provides entropy for sys_rand_get() (IPv6 / MAC randomisation) */
&rng {
	status = "okay";
};

/* ==================== MCUboot dual-slot flash layout ====================
 * Mirrors the WORKING Ethernet-upgrade reference project (ciosZhong_ePSU
 * @ zephyrproject/build_epsu, nucleo_h745zi_q): flash0 is declared as ONE
 * contiguous 2 MB device covering bank1 (0x08000000) + bank2 (0x08100000).
 * A separate flash1 device is NEVER created. Reg offsets are relative to
 * 0x08000000:
 *   boot    128KB @ 0x00000000  (MCUboot)
 *   slot0   512KB @ 0x00020000  (primary app image)
 *   slot1   512KB @ 0x00100000  (secondary / DFU staging image, on bank2)
 * Upgrade mode: SWAP_USING_OFFSET — no scratch partition required.
 * Defined here so both the MCUboot bootloader build and the app build
 * agree on the layout. */
&flash0 {
	reg = <0x08000000 DT_SIZE_M(2)>;
	ranges = <0 0x08000000 DT_SIZE_M(2)>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(128)>;
			read-only;
		};

		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x00020000 DT_SIZE_K(512)>;
		};

		slot1_partition: partition@100000 {
			label = "image-1";
			reg = <0x00100000 DT_SIZE_K(512)>;
		};
	};
};
