/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		watchdog0 = &wwdg;
	};

	/* DIO configuration (per pin_config.xlsx) */
	dout_config: dout_config {
		compatible = "cios-zhong,dout";

		/* 0-12: Relay & power drivers */
		trolley_enable_drv: trolley_enable_drv { gpios = <&gpioh 1  GPIO_ACTIVE_HIGH>; };
		/* dout_01 (PA5) removed — now DAC1_OUT2 for PWR_ON_OFF */
		k3_1_drv: k3_1_drv { gpios = <&gpiok 1  GPIO_ACTIVE_HIGH>; };
		k3_2_drv: k3_2_drv { gpios = <&gpiok 2  GPIO_ACTIVE_HIGH>; };
		k4_drv: k4_drv { gpios = <&gpiok 3  GPIO_ACTIVE_HIGH>; };
		k5_drv: k5_drv { gpios = <&gpioi 4  GPIO_ACTIVE_HIGH>; };
		k6_drv: k6_drv { gpios = <&gpioi 5  GPIO_ACTIVE_HIGH>; };
		k8_1_drv: k8_1_drv { gpios = <&gpioi 6  GPIO_ACTIVE_HIGH>; };
		k8_2_drv: k8_2_drv { gpios = <&gpioi 7  GPIO_ACTIVE_HIGH>; };
		k9_drv: k9_drv { gpios = <&gpioi 9  GPIO_ACTIVE_HIGH>; };
		k10_drv: k10_drv { gpios = <&gpioi 10 GPIO_ACTIVE_HIGH>; };
		k11_drv: k11_drv { gpios = <&gpioi 11 GPIO_ACTIVE_HIGH>; };
		k12_drv: k12_drv { gpios = <&gpioi 12 GPIO_ACTIVE_HIGH>; };

		/* 13-25: Panel LED indicators */
		led_s1_sys_on: led_s1_sys_on { gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>; };
		led_s2_sys_on: led_s2_sys_on { gpios = <&gpiob 11 GPIO_ACTIVE_HIGH>; };
		dbg_led0: dbg_led0 { gpios = <&gpioc 8  GPIO_ACTIVE_HIGH>; };
		dbg_led1: dbg_led1 { gpios = <&gpioc 9  GPIO_ACTIVE_HIGH>; };
		dbg_led2: dbg_led2 { gpios = <&gpioc 10 GPIO_ACTIVE_HIGH>; };
		led_pac230v_on: led_pac230v_on { gpios = <&gpioc 15 GPIO_ACTIVE_HIGH>; };
		led_grid_pwr_in: led_grid_pwr_in { gpios = <&gpiod 2  GPIO_ACTIVE_HIGH>; };
		led_ups_in: led_ups_in { gpios = <&gpiod 3  GPIO_ACTIVE_HIGH>; };
		led_system_on: led_system_on { gpios = <&gpiod 4  GPIO_ACTIVE_HIGH>; };
		led_s2_solo_sys: led_s2_solo_sys { gpios = <&gpiod 5  GPIO_ACTIVE_HIGH>; };
		led_trolley_connected: led_trolley_connected { gpios = <&gpiod 6  GPIO_ACTIVE_HIGH>; };
		led_is_pc_on: led_is_pc_on { gpios = <&gpiod 7  GPIO_ACTIVE_HIGH>; };
		led_apphost_on: led_apphost_on { gpios = <&gpiod 11 GPIO_ACTIVE_HIGH>; };

		/* 26-31: Status output drivers */
		trolley_connected_mcu: trolley_connected_mcu { gpios = <&gpioi 13 GPIO_ACTIVE_HIGH>; };
		trolley_connected_is_pc: trolley_connected_is_pc { gpios = <&gpioi 14 GPIO_ACTIVE_HIGH>; };
		drv_is_pc_site_on: drv_is_pc_site_on { gpios = <&gpioj 11 GPIO_ACTIVE_HIGH>; };
		drv_app_host_site_on: drv_app_host_site_on { gpios = <&gpioj 12 GPIO_ACTIVE_HIGH>; };
		mains_connected_apphost: mains_connected_apphost { gpios = <&gpioj 13 GPIO_ACTIVE_HIGH>; };
		mains_connected_is_pc: mains_connected_is_pc { gpios = <&gpioj 14 GPIO_ACTIVE_HIGH>; };

		/* 32: MAX6703A WDI */
		wdi: wdi { gpios = <&gpioh 9  GPIO_ACTIVE_HIGH>; };
	};

	din_config: din_config {
		compatible = "cios-zhong,din";

		/* 0-3: Status inputs */
		grid_main_relay_status: grid_main_relay_status { gpios = <&gpioh 5  GPIO_ACTIVE_HIGH>; };
		me_box_error: me_box_error { gpios = <&gpioh 6  GPIO_ACTIVE_HIGH>; };
		trolley_connected: trolley_connected { gpios = <&gpioa 0  GPIO_ACTIVE_HIGH>; };
		temp_alert: temp_alert { gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>; };

		/* 4-5: PWR/CP status monitor */
		led_pwr_24_on: led_pwr_24_on { gpios = <&gpioc 6  GPIO_ACTIVE_HIGH>; };
		led_cp_24v_on: led_cp_24v_on { gpios = <&gpioc 7  GPIO_ACTIVE_HIGH>; };

		/* 6-16: System control inputs */
		system_on_off: system_on_off { gpios = <&gpioj 0  GPIO_ACTIVE_HIGH>; };
		system_reset: system_reset { gpios = <&gpioj 1  GPIO_ACTIVE_HIGH>; };
		s1_system_config: s1_system_config { gpios = <&gpioj 2  GPIO_ACTIVE_HIGH>; };
		s2_system_config: s2_system_config { gpios = <&gpioj 3  GPIO_ACTIVE_HIGH>; };
		solo_system_config: solo_system_config { gpios = <&gpioj 4  GPIO_ACTIVE_HIGH>; };
		trolley_connected_j: trolley_connected_j { gpios = <&gpioj 5  GPIO_ACTIVE_HIGH>; };
		is_pc_on: is_pc_on { gpios = <&gpioj 6  GPIO_ACTIVE_HIGH>; };
		app_host_on: app_host_on { gpios = <&gpioj 7  GPIO_ACTIVE_HIGH>; };
		smart_whs_indicate: smart_whs_indicate { gpios = <&gpioj 8  GPIO_ACTIVE_HIGH>; };
		drawer_indicate: drawer_indicate { gpios = <&gpioj 9  GPIO_ACTIVE_HIGH>; };
		smart_ctrl_whs_search: smart_ctrl_whs_search { gpios = <&gpioj 10 GPIO_ACTIVE_HIGH>; };
	};
};

/* Enable window watchdog (disabled by default in SoC DTS) */
&wwdg {
	status = "okay";
};

/* Single-image layout — no bootloader, no slot1 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        slot0_partition: partition@0 {
            label = "image-0";
            reg = <0x08000000 DT_SIZE_K(1024)>;
        };
    };
};

/* Enable ADC instances */
&adc1 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
};

&adc3 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
};

/* Fan PWM pinctrl */
&pinctrl {
    tim8_ch3_pi15: tim8_ch3_pi15 {
        pinmux = <STM32_PINMUX('I', 15, AF2)>;
    };
    tim2_ch4_pj15: tim2_ch4_pj15 {
        pinmux = <STM32_PINMUX('J', 15, AF1)>;
    };
};

/* FAN_PWM2: TIM8 CH3 on PI15 */
&timers8 {
    status = "okay";
    /* PSC=0 -> 240 MHz counter clock; 25 kHz period = 9600 counts (10% duty = 960) */
    st,prescaler = <0>;
    pwm_fan2: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim8_ch3_pi15>;
        pinctrl-names = "default";
    };
};

/* USART1 — second serial port on PB14/PB15 (AF4) */
&usart1 {
	status = "okay";
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

/* FAN_PWM1: TIM2 CH4 on PJ15 */
&timers2 {
    status = "okay";
    /* PSC=0 -> 240 MHz counter clock; 25 kHz period = 9600 counts (10% duty = 960) */
    st,prescaler = <0>;
    pwm_fan1: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim2_ch4_pj15>;
        pinctrl-names = "default";
    };
};

/* DAC1_OUT2 on PA5 — pwr_on_off control */
&dac1 {
    status = "okay";
};

/* Analog input + Fan PWM + DAC channels */
/ {
    zephyr,user {
        dac = <&dac1>;
        dac_channel_id = <2>;
        dac_resolution = <12>;

        io-channels =
            <&adc3 4>,
            <&adc3 5>,
            <&adc3 6>,
            <&adc3 7>,
            <&adc3 8>,
            <&adc1 15>,
            <&adc1 18>,
            <&adc1 3>,
            <&adc1 10>,
            <&adc1 9>,
            <&adc1 5>,
            <&adc1 12>,
            <&adc1 13>,
            <&adc3 14>;

        pwms =
            <&pwm_fan1 4 PWM_USEC(40) PWM_POLARITY_NORMAL>,   /* 40 us = 25 kHz fan carrier */
            <&pwm_fan2 3 PWM_USEC(40) PWM_POLARITY_NORMAL>;
    };
};
