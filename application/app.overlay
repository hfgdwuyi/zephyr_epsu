/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		watchdog0 = &wwdg;
	};

	/* DIO configuration (per pin_config.xlsx).
	 * The DOUT/DIN index of each pin IS its reg value — bsp_dio.h derives
	 * DOUT_xxx/DIN_xxx from these labels, and bsp_dio.c builds its spec array
	 * keyed by reg. reg must stay dense 0..N-1 (the DOUT bitmap splits at
	 * bit 32 and spec[i] == reg i). Insert a pin → renumber reg here only. */
	dout_config: dout_config {
		compatible = "cios-zhong,dout";
		#address-cells = <1>;
		#size-cells = <0>;

		/* 0: trolley enable (relay/power driver) */
		trolley_enable_drv: trolley_enable_drv@0 { reg = <0>; gpios = <&gpioh 1  GPIO_ACTIVE_HIGH>; };

		/* 1: MAX6703A WDI */
		wdi: wdi@1 { reg = <1>; gpios = <&gpioh 9  GPIO_ACTIVE_HIGH>; };

		/* 2-3: Power good / K13 enable */
		pg_13v5: pg_13v5@2 { reg = <2>; gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>; };
		k13_en: k13_en@3 { reg = <3>; gpios = <&gpiob 6  GPIO_ACTIVE_HIGH>; };

		/* 4-6: Debug LEDs */
		dbg_led0: dbg_led0@4 { reg = <4>; gpios = <&gpioc 8  GPIO_ACTIVE_HIGH>; };
		dbg_led1: dbg_led1@5 { reg = <5>; gpios = <&gpioc 9  GPIO_ACTIVE_HIGH>; };
		dbg_led2: dbg_led2@6 { reg = <6>; gpios = <&gpioc 10 GPIO_ACTIVE_HIGH>; };

		/* 7-16: Panel LED indicators
		 * Note: PD8 (led_pac230v_on) and PD9 (led_s1_sys_on) removed —
		 * those pins are USART3 TX/RX (ST-Link VCP console). */
		led_pwr_24_on: led_pwr_24_on@7 { reg = <7>; gpios = <&gpiod 0  GPIO_ACTIVE_HIGH>; };
		led_cp_224v_on: led_cp_224v_on@8 { reg = <8>; gpios = <&gpiod 1  GPIO_ACTIVE_HIGH>; };
		led_grid_pwr_in: led_grid_pwr_in@9 { reg = <9>; gpios = <&gpiod 2  GPIO_ACTIVE_HIGH>; };
		led_ups_in: led_ups_in@10 { reg = <10>; gpios = <&gpiod 3  GPIO_ACTIVE_HIGH>; };
		led_system_on: led_system_on@11 { reg = <11>; gpios = <&gpiod 4  GPIO_ACTIVE_HIGH>; };
		led_s2_solo_sys: led_s2_solo_sys@12 { reg = <12>; gpios = <&gpiod 5  GPIO_ACTIVE_HIGH>; };
		led_trolley_connected: led_trolley_connected@13 { reg = <13>; gpios = <&gpiod 6  GPIO_ACTIVE_HIGH>; };
		led_is_pc_on: led_is_pc_on@14 { reg = <14>; gpios = <&gpiod 7  GPIO_ACTIVE_HIGH>; };
		led_s2_sys_on: led_s2_sys_on@15 { reg = <15>; gpios = <&gpiod 10 GPIO_ACTIVE_HIGH>; };
		led_app_host_on: led_app_host_on@16 { reg = <16>; gpios = <&gpiod 12 GPIO_ACTIVE_HIGH>; };

		/* 17-28: Relay / power drivers (K2..K13) */
		k5_drv: k5_drv@17 { reg = <17>; gpios = <&gpioi 4  GPIO_ACTIVE_HIGH>; };
		k6_drv: k6_drv@18 { reg = <18>; gpios = <&gpioi 5  GPIO_ACTIVE_HIGH>; };
		k3_drv: k3_drv@19 { reg = <19>; gpios = <&gpioi 6  GPIO_ACTIVE_HIGH>; };
		k2_drv: k2_drv@20 { reg = <20>; gpios = <&gpioi 7  GPIO_ACTIVE_HIGH>; };
		k4_drv: k4_drv@21 { reg = <21>; gpios = <&gpioi 8  GPIO_ACTIVE_HIGH>; };
		k7_drv: k7_drv@22 { reg = <22>; gpios = <&gpioi 9  GPIO_ACTIVE_HIGH>; };
		k10_en: k10_en@23 { reg = <23>; gpios = <&gpioi 10 GPIO_ACTIVE_HIGH>; };
		k11_en: k11_en@24 { reg = <24>; gpios = <&gpioi 11 GPIO_ACTIVE_HIGH>; };
		k12_en: k12_en@25 { reg = <25>; gpios = <&gpioi 12 GPIO_ACTIVE_HIGH>; };
		k8_1_en: k8_1_en@26 { reg = <26>; gpios = <&gpioi 13 GPIO_ACTIVE_HIGH>; };
		k8_2_en: k8_2_en@27 { reg = <27>; gpios = <&gpioi 14 GPIO_ACTIVE_HIGH>; };
		k9_en: k9_en@28 { reg = <28>; gpios = <&gpioi 15 GPIO_ACTIVE_HIGH>; };

		/* 29-32: Status output drivers */
		drv_is_pc_site_on: drv_is_pc_site_on@29 { reg = <29>; gpios = <&gpioj 11 GPIO_ACTIVE_HIGH>; };
		drv_app_host_site_on: drv_app_host_site_on@30 { reg = <30>; gpios = <&gpioj 12 GPIO_ACTIVE_HIGH>; };
		mains_connected_is_pc: mains_connected_is_pc@31 { reg = <31>; gpios = <&gpioj 13 GPIO_ACTIVE_HIGH>; };
		mains_connected_mcu: mains_connected_mcu@32 { reg = <32>; gpios = <&gpioj 14 GPIO_ACTIVE_HIGH>; };
	};

	din_config: din_config {
		compatible = "cios-zhong,din";
		#address-cells = <1>;
		#size-cells = <0>;

		/* 0-1: Status inputs */
		grid_main_relay_status: grid_main_relay_status@0 { reg = <0>; gpios = <&gpioh 5  GPIO_ACTIVE_HIGH>; };
		me_box_error: me_box_error@1 { reg = <1>; gpios = <&gpioh 6  GPIO_ACTIVE_HIGH>; };

		/* 2-5: Fault inputs (PA8-PA11) */
		fault0: fault0@2 { reg = <2>; gpios = <&gpioa 8  GPIO_ACTIVE_HIGH>; };
		fault1: fault1@3 { reg = <3>; gpios = <&gpioa 9  GPIO_ACTIVE_HIGH>; };
		fault2: fault2@4 { reg = <4>; gpios = <&gpioa 10 GPIO_ACTIVE_HIGH>; };
		fault3: fault3@5 { reg = <5>; gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>; };

		/* 6-7: Temperature alert + PWR-24 feedback */
		temp_alert: temp_alert@6 { reg = <6>; gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>; };
		led_pwr_24_fb: led_pwr_24_fb@7 { reg = <7>; gpios = <&gpioc 6  GPIO_ACTIVE_HIGH>; };

		/* 8-10: Fault inputs (PC11-PC13) */
		fault4: fault4@8 { reg = <8>; gpios = <&gpioc 11 GPIO_ACTIVE_HIGH>; };
		fault5: fault5@9 { reg = <9>; gpios = <&gpioc 12 GPIO_ACTIVE_HIGH>; };
		fault6: fault6@10 { reg = <10>; gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>; };

		/* 11-12: Trolley / status monitor */
		trl_mu_connected_mcu: trl_mu_connected_mcu@11 { reg = <11>; gpios = <&gpiod 13 GPIO_ACTIVE_HIGH>; };
		trl_mu_connected_is_pc: trl_mu_connected_is_pc@12 { reg = <12>; gpios = <&gpiod 14 GPIO_ACTIVE_HIGH>; };

		/* 13-23: System control inputs */
		system_on_off: system_on_off@13 { reg = <13>; gpios = <&gpioj 0  GPIO_ACTIVE_HIGH>; };
		system_reset: system_reset@14 { reg = <14>; gpios = <&gpioj 1  GPIO_ACTIVE_HIGH>; };
		s1_system_config: s1_system_config@15 { reg = <15>; gpios = <&gpioj 2  GPIO_ACTIVE_HIGH>; };
		s2_system_config: s2_system_config@16 { reg = <16>; gpios = <&gpioj 3  GPIO_ACTIVE_HIGH>; };
		solo_system_config: solo_system_config@17 { reg = <17>; gpios = <&gpioj 4  GPIO_ACTIVE_HIGH>; };
		trolley_connected: trolley_connected@18 { reg = <18>; gpios = <&gpioj 5  GPIO_ACTIVE_HIGH>; };
		app_host_on: app_host_on@19 { reg = <19>; gpios = <&gpioj 7  GPIO_ACTIVE_HIGH>; };
		smart_whs_indicate: smart_whs_indicate@20 { reg = <20>; gpios = <&gpioj 8  GPIO_ACTIVE_HIGH>; };
		drawer_indicate: drawer_indicate@21 { reg = <21>; gpios = <&gpioj 9  GPIO_ACTIVE_HIGH>; };
		smart_ctrl_whs_search: smart_ctrl_whs_search@22 { reg = <22>; gpios = <&gpioj 10 GPIO_ACTIVE_HIGH>; };
		is_pc_on: is_pc_on@23 { reg = <23>; gpios = <&gpioj 15 GPIO_ACTIVE_HIGH>; };
	};
};

/* Enable window watchdog (disabled by default in SoC DTS) */
&wwdg {
	status = "okay";
};

/* Single-image layout — no bootloader, no slot1 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        slot0_partition: partition@0 {
            label = "image-0";
            reg = <0x08000000 DT_SIZE_K(1024)>;
        };
    };
};

/* Enable ADC instances */
&adc1 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
};

&adc2 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
};

&adc3 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
};

/* Fan PWM pinctrl (H745 alternate functions) */
&pinctrl {
    /* fan2_pwm: TIM4_CH4 on PD15 (AF2) — auto-generated node exists */
    tim8_ch2_pj6: tim8_ch2_pj6 {
        pinmux = <STM32_PINMUX('J', 6, AF3)>;   /* fan1_pwm: TIM8_CH2 */
    };
};

/* FAN_PWM2: TIM4 CH4 on PD15 */
&timers4 {
    status = "okay";
    /* PSC=0 -> 240 MHz counter clock; 25 kHz period = 9600 counts (10% duty = 960) */
    st,prescaler = <0>;
    pwm_fan2: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim4_ch4_pd15>;
        pinctrl-names = "default";
    };
};

/* USART1 — second serial port on PB14/PB15 (AF4) */
&usart1 {
	status = "okay";
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

/* FAN_PWM1: TIM8 CH2 on PJ6 */
&timers8 {
    status = "okay";
    /* PSC=0 -> 240 MHz counter clock; 25 kHz period = 9600 counts (10% duty = 960) */
    st,prescaler = <0>;
    pwm_fan1: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim8_ch2_pj6>;
        pinctrl-names = "default";
    };
};

/* DAC1_OUT2 on PA5 — pwr_on_off control */
&dac1 {
    status = "okay";
};

/* Analog input + Fan PWM + DAC channels */
/ {
    zephyr,user {
        dac = <&dac1>;
        dac_channel_id = <2>;
        dac_resolution = <12>;

        /* AC zero-crossing input from external TL3310 comparator
         * (PC14, toggling square wave at 2x mains frequency).
         * Owned by the acmeter module for period/frequency + RMS windowing. */
        zero-en-gpios = <&gpioc 14 GPIO_ACTIVE_HIGH>;

        io-channels =
            <&adc3 13>,   /*  0: adc_12v   — PH2     ADC3_INP13 */
            <&adc1 2>,    /*  1: adc_pdc7  — PF11    ADC1_INP2  */
            <&adc1 6>,    /*  2: adc_pdc6  — PF12    ADC1_INP6  */
            <&adc2 2>,    /*  3: adc_pdc5  — PF13    ADC2_INP2  */
            <&adc2 6>,    /*  4: adc_5v0   — PF14    ADC2_INP6  */
            <&adc1 15>,   /*  5: adc_temp1 — PA3     ADC12_INP15 */
            <&adc1 18>,   /*  6: adc_temp2 — PA4     ADC12_INP18 */
            <&adc1 3>,    /*  7: adc_pdc0  — PA6     ADC12_INP3  */
            <&adc1 0>,    /*  8: adc_pdc4  — PA0_C   ADC12_INP0  */
            <&adc1 9>,    /*  9: adc_pdc2  — PB0     ADC12_INP9  */
            <&adc1 5>,    /* 10: adc_pdc3  — PB1     ADC12_INP5  */
            <&adc3 10>,   /* 11: adc_3v3   — PC0     ADC3_INP10 */
            <&adc3 12>,   /* 12: adc_pdc1  — PC2     ADC3_INP12 */
            <&adc3 0>,    /* 13: adc_vin   — PC2_C   ADC3_INP0  */
            <&adc3 1>;    /* 14: adc_pdc0  — PC3_C   ADC3_INP1  */

        pwms =
            <&pwm_fan1 2 PWM_USEC(40) PWM_POLARITY_NORMAL>,   /* 40 us = 25 kHz fan carrier */
            <&pwm_fan2 4 PWM_USEC(40) PWM_POLARITY_NORMAL>;
    };
};

/* ---- 24C04 I2C EEPROM（512×8）@ I2C1 + PB7 = WP ----
 * I2C1 引脚 = NUCLEO 板级默认 PB8(SCL)/PB9(SDA)（Arduino header）。
 * WP 由 at2x 驱动管理（写前解除、写毕置回，上电=写保护）。极性取 24C04 惯例：
 * WP 高=写保护 → GPIO_ACTIVE_HIGH（logical 1→物理高）。
 * 注意：开发板 PB7 同时是 LPUART1 RX —— 若 LPUART1 保持使能，两驱动会争用该脚
 * （at2x 初始化优先级 80 会把 PB7 配成 GPIO 输出）。开发板测试 EEPROM 时建议
 * 先禁用 &lpuart1（或按板载跳线断开 LPUART1）。
 * A2 地址引脚未接 → 基址 0x50。 */
&i2c1 {
    clock-frequency = <I2C_BITRATE_FAST>;
    identity_eeprom: eeprom@50 {
        compatible = "atmel,at24";
        reg = <0x50>;
        size = <512>;
        pagesize = <16>;
        address-width = <8>;
        timeout = <5>;
        wp-gpios = <&gpiob 7 GPIO_ACTIVE_HIGH>;
    };
};

/* ---- 外部 64Mbit QSPI NOR = IS25LP064（ISSI，SFDP/JEDEC，4K 扇区）----
 * 引脚 per pin_config.xlsx: PF8=io0 PF9=io1 PF7=io2 PF6=io3 PF10=clk
 * NCS 未在 xlsx 列出 → 暂用 PG6（本封装可用、两板均空闲），待原理图确认。
 * 开发板无此器件 → JEDEC probe 失败 not-ready 可接受，不阻塞启动。 */
&quadspi {
    pinctrl-0 = <&quadspi_clk_pf10
                 &quadspi_bk1_io0_pf8
                 &quadspi_bk1_io1_pf9
                 &quadspi_bk1_io2_pf7
                 &quadspi_bk1_io3_pf6
                 &quadspi_bk1_ncs_pg6>;
    pinctrl-names = "default";
    status = "okay";

    is25lp064: qspi-nor-flash@0 {
        compatible = "st,stm32-qspi-nor";
        reg = <0>;
        #address-cells = <1>;
        #size-cells = <1>;
        size = <DT_SIZE_M(64)>;            /* 64 Mbit = 8 MB */
        qspi-max-frequency = <50000000>;   /* IS25LP064 SFDP 上限 133MHz，保守 50MHz */
        spi-bus-width = <4>;
        status = "okay";

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            /* 固件设计分区布局（后续 OTA/从站分发用）：
             * slot1 1M @0，从站暂存 4M @0x100000，
             * storage 1M @0x500000，reserved 2M @0x600000 */
            slot1_partition: partition@0 {
                label = "image-1";
                reg = <0x000000 DT_SIZE_M(1)>;
            };
            slave_fw_staging: partition@100000 {
                label = "slave-fw";
                reg = <0x100000 DT_SIZE_M(4)>;
            };
            storage_partition: partition@500000 {
                label = "storage";
                reg = <0x500000 DT_SIZE_M(1)>;
            };
            reserved_partition: partition@600000 {
                label = "reserved";
                reg = <0x600000 DT_SIZE_M(2)>;
            };
        };
    };
};
