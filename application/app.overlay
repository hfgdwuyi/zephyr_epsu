/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		watchdog0 = &wwdg;
	};

	/* DIO configuration (per pin_config.xlsx) */
	dout_config: dout_config {
		compatible = "cios-zhong,dout";

		/* 0-12: Relay & power drivers */
		dout_00: dout_00 { gpios = <&gpioh 1  GPIO_ACTIVE_HIGH>; };
		dout_01: dout_01 { gpios = <&gpioa 5  GPIO_ACTIVE_HIGH>; };
		dout_02: dout_02 { gpios = <&gpiok 1  GPIO_ACTIVE_HIGH>; };
		dout_03: dout_03 { gpios = <&gpiok 2  GPIO_ACTIVE_HIGH>; };
		dout_04: dout_04 { gpios = <&gpiok 3  GPIO_ACTIVE_HIGH>; };
		dout_05: dout_05 { gpios = <&gpioi 4  GPIO_ACTIVE_HIGH>; };
		dout_06: dout_06 { gpios = <&gpioi 5  GPIO_ACTIVE_HIGH>; };
		dout_07: dout_07 { gpios = <&gpioi 6  GPIO_ACTIVE_HIGH>; };
		dout_08: dout_08 { gpios = <&gpioi 7  GPIO_ACTIVE_HIGH>; };
		dout_09: dout_09 { gpios = <&gpioi 9  GPIO_ACTIVE_HIGH>; };
		dout_10: dout_10 { gpios = <&gpioi 10 GPIO_ACTIVE_HIGH>; };
		dout_11: dout_11 { gpios = <&gpioi 11 GPIO_ACTIVE_HIGH>; };
		dout_12: dout_12 { gpios = <&gpioi 12 GPIO_ACTIVE_HIGH>; };

		/* 13-25: Panel LED indicators */
		dout_13: dout_13 { gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>; };
		dout_14: dout_14 { gpios = <&gpiob 11 GPIO_ACTIVE_HIGH>; };
		dout_15: dout_15 { gpios = <&gpioc 8  GPIO_ACTIVE_HIGH>; };
		dout_16: dout_16 { gpios = <&gpioc 9  GPIO_ACTIVE_HIGH>; };
		dout_17: dout_17 { gpios = <&gpioc 10 GPIO_ACTIVE_HIGH>; };
		dout_18: dout_18 { gpios = <&gpioc 15 GPIO_ACTIVE_HIGH>; };
		dout_19: dout_19 { gpios = <&gpiod 2  GPIO_ACTIVE_HIGH>; };
		dout_20: dout_20 { gpios = <&gpiod 3  GPIO_ACTIVE_HIGH>; };
		dout_21: dout_21 { gpios = <&gpiod 4  GPIO_ACTIVE_HIGH>; };
		dout_22: dout_22 { gpios = <&gpiod 5  GPIO_ACTIVE_HIGH>; };
		dout_23: dout_23 { gpios = <&gpiod 6  GPIO_ACTIVE_HIGH>; };
		dout_24: dout_24 { gpios = <&gpiod 7  GPIO_ACTIVE_HIGH>; };
		dout_25: dout_25 { gpios = <&gpiod 11 GPIO_ACTIVE_HIGH>; };

		/* 26-31: Status output drivers */
		dout_26: dout_26 { gpios = <&gpioi 13 GPIO_ACTIVE_HIGH>; };
		dout_27: dout_27 { gpios = <&gpioi 14 GPIO_ACTIVE_HIGH>; };
		dout_28: dout_28 { gpios = <&gpioj 11 GPIO_ACTIVE_HIGH>; };
		dout_29: dout_29 { gpios = <&gpioj 12 GPIO_ACTIVE_HIGH>; };
		dout_30: dout_30 { gpios = <&gpioj 13 GPIO_ACTIVE_HIGH>; };
		dout_31: dout_31 { gpios = <&gpioj 14 GPIO_ACTIVE_HIGH>; };

		/* 32: MAX6703A WDI */
		dout_32: dout_32 { gpios = <&gpioh 9  GPIO_ACTIVE_HIGH>; };
	};

	din_config: din_config {
		compatible = "cios-zhong,din";

		/* 0-3: Status inputs */
		din_00: din_00 { gpios = <&gpioh 5  GPIO_ACTIVE_HIGH>; };
		din_01: din_01 { gpios = <&gpioh 6  GPIO_ACTIVE_HIGH>; };
		din_02: din_02 { gpios = <&gpioa 0  GPIO_ACTIVE_HIGH>; };
		din_03: din_03 { gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>; };

		/* 4-5: PWR/CP status monitor */
		din_04: din_04 { gpios = <&gpioc 6  GPIO_ACTIVE_HIGH>; };
		din_05: din_05 { gpios = <&gpioc 7  GPIO_ACTIVE_HIGH>; };

		/* 6-16: System control inputs */
		din_06: din_06 { gpios = <&gpioj 0  GPIO_ACTIVE_HIGH>; };
		din_07: din_07 { gpios = <&gpioj 1  GPIO_ACTIVE_HIGH>; };
		din_08: din_08 { gpios = <&gpioj 2  GPIO_ACTIVE_HIGH>; };
		din_09: din_09 { gpios = <&gpioj 3  GPIO_ACTIVE_HIGH>; };
		din_10: din_10 { gpios = <&gpioj 4  GPIO_ACTIVE_HIGH>; };
		din_11: din_11 { gpios = <&gpioj 5  GPIO_ACTIVE_HIGH>; };
		din_12: din_12 { gpios = <&gpioj 6  GPIO_ACTIVE_HIGH>; };
		din_13: din_13 { gpios = <&gpioj 7  GPIO_ACTIVE_HIGH>; };
		din_14: din_14 { gpios = <&gpioj 8  GPIO_ACTIVE_HIGH>; };
		din_15: din_15 { gpios = <&gpioj 9  GPIO_ACTIVE_HIGH>; };
		din_16: din_16 { gpios = <&gpioj 10 GPIO_ACTIVE_HIGH>; };
	};
};

/* Enable window watchdog (disabled by default in SoC DTS) */
&wwdg {
	status = "okay";
};

/* Single-image layout — no bootloader, no slot1 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        slot0_partition: partition@0 {
            label = "image-0";
            reg = <0x08000000 DT_SIZE_K(1024)>;
        };
    };
};

/* Enable ADC instances */
&adc1 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
};

&adc3 {
    status = "okay";
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
};

/* Fan PWM pinctrl */
&pinctrl {
    tim8_ch3_pi15: tim8_ch3_pi15 {
        pinmux = <STM32_PINMUX('I', 15, AF2)>;
    };
    tim2_ch4_pj15: tim2_ch4_pj15 {
        pinmux = <STM32_PINMUX('J', 15, AF1)>;
    };
};

/* FAN_PWM2: TIM8 CH3 on PI15 */
&timers8 {
    status = "okay";
    st,prescaler = <10000>;
    pwm_fan2: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim8_ch3_pi15>;
        pinctrl-names = "default";
    };
};

/* USART1 — second serial port on PB14/PB15 (AF4) */
&usart1 {
	status = "okay";
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

/* FAN_PWM1: TIM2 CH4 on PJ15 */
&timers2 {
    status = "okay";
    st,prescaler = <10000>;
    pwm_fan1: pwm {
        compatible = "st,stm32-pwm";
        status = "okay";
        pinctrl-0 = <&tim2_ch4_pj15>;
        pinctrl-names = "default";
    };
};

/* Analog input + Fan PWM channels */
/ {
    zephyr,user {
        io-channels =
            <&adc3 4>,
            <&adc3 5>,
            <&adc3 6>,
            <&adc3 7>,
            <&adc3 8>,
            <&adc1 15>,
            <&adc1 18>,
            <&adc1 3>,
            <&adc1 10>,
            <&adc1 9>,
            <&adc1 5>,
            <&adc1 12>,
            <&adc1 13>,
            <&adc3 14>;

        pwms =
            <&pwm_fan1 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
            <&pwm_fan2 3 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
    };
};
