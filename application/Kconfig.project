# cios-zhong — project-specific configuration options

config CIOS_ZHONG_FW_VERSION
	string "Firmware version"
	default "0.3.0"
	help
	  Firmware version string in MAJOR.MINOR.PATCH format.
	  Displayed on boot and available via status queries.

config CIOS_ZHONG_BOOT_VERSION
	string "Bootloader (MCUboot) version"
	default "1.0.0"
	help
	  Version string of the MCUboot bootloader this firmware is released
	  with. Displayed on boot and available via the 'info' command so the
	  boot/app pair on a board can be identified at a glance.

config CIOS_ZHONG_BRINGUP
	bool "Minimal bring-up test (LED blink only, watchdogs disabled)"
	default y
	help
	  When enabled, main() only initializes GPIO/LEDs and blinks them,
	  disabling the state machine, WWDG and other subsystems so a fresh
	  board can be verified without the risk of watchdog deadlock.
	  Set to n for the full PSU application.

config CIOS_ZHONG_CANOPEN_NODE_ID
	int "CANopen node ID"
	range 1 127
	default 1
	help
	  CANopen 节点号（1..127）。0 保留给广播，128..255 非法。
	  由 getNodeId() 提供给协议栈（application/src/main/usr_301.c）。
