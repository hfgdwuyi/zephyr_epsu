/*
 * mcuboot_wdi.overlay - external watchdog WDI GPIO (PH9) for MCUboot
 *
 * While MCUboot copies slot1 -> slot0 the external MAX6703A (WDI=PH9) must
 * keep being fed, otherwise its 1.6 s timeout resets the MCU mid-copy and
 * leaves slot0 half written. A custom mcuboot_watchdog_feed() toggles it.
 */
/ {
	wdi-gpio {
		compatible = "gpio-leds";
		mcuboot_wdi: mcuboot_wdi {
			gpios = <&gpioh 9 GPIO_ACTIVE_HIGH>;
			label = "MCUboot external watchdog WDI (PH9)";
		};
	};
};
