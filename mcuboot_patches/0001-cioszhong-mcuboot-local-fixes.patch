diff --git a/boot/zephyr/main.c b/boot/zephyr/main.c
index 90678743..ca22cf95 100644
--- a/boot/zephyr/main.c
+++ b/boot/zephyr/main.c
@@ -30,9 +30,7 @@
 #include <soc.h>
 #include <zephyr/linker/linker-defs.h>
 
-#if defined(CONFIG_BOOT_DISABLE_CACHES)
 #include <zephyr/cache.h>
-#endif
 
 #if defined(CONFIG_CPU_CORTEX_M)
 #include <cmsis_core.h>
@@ -535,6 +533,18 @@ int main(void)
     BOOT_LOG_INF("Starting Direct-XIP bootloader");
 #endif
 
+    /*
+     * Invalidate caches before any flash reads. The ROM bootloader enables
+     * caches without invalidating them first, so stale data from before
+     * flash programming may be cached. This causes MCUboot to read wrong
+     * image header fields (e.g., img_size) on the first boot after flashing.
+     *
+     * Use clean+invalidate (not just invalidate) because the D-Cache may
+     * contain dirty lines from the ROM bootloader's stack/heap operations.
+     */
+    sys_cache_instr_invd_all();
+    sys_cache_data_flush_and_invd_all();
+
 #ifdef CONFIG_MCUBOOT_INDICATION_LED
     /* LED init */
     io_led_init();
diff --git a/boot/zephyr/watchdog.c b/boot/zephyr/watchdog.c
index 265e17bd..2ed01f64 100644
--- a/boot/zephyr/watchdog.c
+++ b/boot/zephyr/watchdog.c
@@ -10,6 +10,8 @@
 #include <bootutil/bootutil_log.h>
 #include <zephyr/device.h>
 #include <zephyr/drivers/watchdog.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/devicetree.h>
 
 #ifdef CONFIG_BOOT_WATCHDOG_FEED_NRFX_WDT
 #include <nrfx_wdt.h>
@@ -17,6 +19,12 @@
 
 BOOT_LOG_MODULE_DECLARE(mcuboot);
 
+/* CiosZhong: external MAX6703A WDI (PH9), defined by mcuboot_wdi.overlay */
+#if DT_NODE_EXISTS(DT_NODELABEL(mcuboot_wdi))
+static const struct gpio_dt_spec mcuboot_wdi_gpio =
+	GPIO_DT_SPEC_GET(DT_NODELABEL(mcuboot_wdi), gpios);
+#endif
+
 /*
  * Channel of watchdog that is setup and fed, if CONFIG_BOOT_WATCHDOG_INSTALL_TIMEOUT_AT_BOOT is
  * not set then this will remain at the default of 0 but the driver will not have been set up
@@ -30,6 +38,13 @@ static int watchdog_channel = 0;
 
 __weak void mcuboot_watchdog_setup(void)
 {
+    /* CiosZhong: configure MAX6703A WDI (PH9) as output, initially low */
+#if DT_NODE_EXISTS(DT_NODELABEL(mcuboot_wdi))
+    if (device_is_ready(mcuboot_wdi_gpio.port)) {
+        gpio_pin_configure_dt(&mcuboot_wdi_gpio, GPIO_OUTPUT);
+        gpio_pin_set_dt(&mcuboot_wdi_gpio, 0);
+    }
+#endif
 #if defined(CONFIG_BOOT_WATCHDOG_SETUP_AT_BOOT) && DT_NODE_HAS_STATUS(DT_ALIAS(watchdog0), okay)
     const struct device *watchdog_device = DEVICE_DT_GET(DT_ALIAS(watchdog0));
 
@@ -96,4 +111,13 @@ __weak void mcuboot_watchdog_feed(void)
         wdt_feed(watchdog_device, watchdog_channel);
     }
 #endif
+
+    /* CiosZhong: feed MAX6703A (WDI PH9) - toggle on every feed */
+#if DT_NODE_EXISTS(DT_NODELABEL(mcuboot_wdi))
+    static bool wdi_level;
+    if (device_is_ready(mcuboot_wdi_gpio.port)) {
+        wdi_level = !wdi_level;
+        gpio_pin_set_dt(&mcuboot_wdi_gpio, wdi_level ? 1 : 0);
+    }
+#endif
 }
