diff --git a/boot/bootutil/src/swap_offset.c b/boot/bootutil/src/swap_offset.c
index eda68ab9..c468c721 100644
--- a/boot/bootutil/src/swap_offset.c
+++ b/boot/bootutil/src/swap_offset.c
@@ -178,6 +178,13 @@ int boot_read_image_header(struct boot_loader_state *state, int slot,
     assert(fap != NULL);
 
     rc = flash_area_read(fap, off, out_hdr, sizeof *out_hdr);
+    BOOT_LOG_ERR("DEBUG swap_offset: slot=%d fa_id=%d fa_off=0x%lx off=0x%lx "
