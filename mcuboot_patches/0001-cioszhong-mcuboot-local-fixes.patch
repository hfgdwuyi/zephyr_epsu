+    available_pri_sz = pri_sectors * sector_sz - trailer_sz;
+    available_sec_sz = sec_sectors * sector_sz - trailer_sz - padding_sz;
+
+    BOOT_LOG_ERR("DEBUG app_max_size: pri_sec=%lu sec_sec=%lu sec_sz=0x%lx "
+                 "trailer=0x%lx avail_pri=0x%lx avail_sec=0x%lx ret=0x%lx",
+                 (unsigned long)pri_sectors, (unsigned long)sec_sectors,
+                 (unsigned long)sector_sz, (unsigned long)trailer_sz,
+                 (unsigned long)available_pri_sz, (unsigned long)available_sec_sz,
+                 (unsigned long)(available_pri_sz < available_sec_sz ?
