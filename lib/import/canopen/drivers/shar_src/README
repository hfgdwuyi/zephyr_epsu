Shared sources for CAN controller. 

CAN driver modules
------------------
can_320.c	TI DSP internal CAN like TMS320F2407A
can_80390.c	Dallas DS80C390
can_82527.c	82527, C5x5, C164, C167
can_90540.c	16bit Fujitsu like MB90F543
can_am335x.c   TI sitara (ARM Cortex A8, internal DCAN)
can_arcom.c	PC104 CAN board for Arcom WinCE
can_at91.c	Atmel internal CAN like AT91SAM7A2
can_at91sam7a3.c Atmel AT91SAM7A3 internal CAN
can_at91sam7X.c  Atmel AT91SAM7X internal CAN
can_at91sam9263.c Atmel AT91SAM9263 internal CAN
can_atsam4e.c 	Atmel ATSAM4E internal CAN
can_avr32.c	Atmel internal CAN (AVR32)
can_bxcan.c	ST bxCAN (STM32F10x, STM32F2xx, STM32F4xx, STM32F3xx, STM32L4xx, STM32F7xx)
can_bxcan_stm32f0.c	ST bxCAN specific for STM32F0xx
can_bxcan_virtual_multiline.c	ST bxCAN specific STM3210x
can_can4linux.c LINUX  based on can4linux device driver
can_canary.c	Atmel CANary like T89C51CC01, AVR
can_ccan.c	Bosch C_CAN (C8051F040)
can_cpc.c	CPC driver (Multi Line)
can_dcan.c	Bosch D_CAN (TI sitara am437x, TMS320F28377)
can_dcan_tm4c.c  Bosch D_CAN (TI Tiva special variant)
can_dcan_tms320.c  Bosch D_CAN (TI TMS320F28379)
can_dcan_tms570.c  Bosch D_CAN (TI Hercules special variant)
can_dcan_msp432x.c Bosch D_CAN (TI MSP432E4x variant like TI Tiva)
can_dspic30f.c	MicroChip CAN dsPIC30F
can_dspic33f.c	MicroChip CAN dsPIC33F
can_dspic33epxx.c	MicroChip CAN dsPIC33EPxx
can_dspic33evxx.c	MicroChip CAN dsPIC33EVxx
can_ecan.c	eCAN like TMS320LF2812
can_FCAN.c	NEC aFCAN PD70F3231
can_fcn.c	renesas NECV850Fx4, V850E2/ML4 + R-IN32M3
can_f28m35x.c   TI C2000 Concerto DCAN
can_flexcan.c	Freescale FlexCAN
can_flexcan_kinetis.c	Freescale FlexCAN for Kinetis cpu family
can_flexcan_s32.c NXP FlexCAN for S32 family
can_stm32_fdcan.c	ST STM32G4xx (FDCAN)
can_generic.c	Generic CAN driver for new development
can_hecc.c	TI HECC (High End CAN controller like TI eCAN)
can_horch.c	horch interface
can_ipc143.c	Beck IPC
can_ixxat_vci.c  IXXAT PC interface windows
can_jpcan.c	Janz CAN-USB Interface (only m4d)
can_lpc21.c	NXP LPC2000 internal CAN (LPC1700, LPC4000, LPC2100, LPC2300, LPC2400)
can_m16c.c	Renesas M16C
can_mcp2517fd.c Microchip extended CAN controller MCP2517FD
can_mscan.c	Freescale msCAN8, msCAN12, msCAN12 Rev2 (e.d. HC908GZ60, HCS12, DSP 5680x, Kinetis KE06) 
can_multican.c	Infineon MultiCAN base on XE164
can_multican_aurix.c	Infineon MultiCAN+ base on Aurix TC23x
can_multican_xmc4500.c	Infineon MultiCAN base on XMC4500
can_multican_xmc4800.c	Infineon MultiCAN base on XMC4800
can_multican_xmc4200.c	Infineon MultiCAN base on XMC4200
can_multican_xmc4300.c	Infineon MultiCAN base on XMC4300
can_pic32mx.c	Microchip PIC32 CAN
can_pic_ecan.c	MicroChip CAN PIC18F 
can_rcan_sh72544r.c	Renesas SH72544R
can_rl78f13.c   Renesas RL78F13
can_rl78f14.c   Renesas RL78F14
can_rscan.c     Renesas RSCAN
can_rscan_rh850.c  Renesas RSCAN base on RH850
can_rscan_rzt1.c   Renesas RSCAN base on RZ/T1
can_rx63n.c     renesas rx63n
can_rx62n.c     renesas rx62n
can_rx64m.c     renesas rx64m
can_rx65n.c     renesas rx65n
can_rx71m.c     renesas rx71m
can_rx72m.c     renesas rx72m
can_sie.c	Sontheim Industrieelektronik CANFox (u.a.) (nur m4d)
can_sja1000.c	SJA1000 Pelican mode
can_socketcan	LINUX based SocketCAN device driver
can_synergy.c   Renesas synergy CAN interface
can_tinycan.c	MHS TinyCAN IV (only m4d)
can_toucan.c	Freescale TouCAN
can_twincan.c	Infineon Twincan base on XC164
can_vector.c    Vector XL Driver Library
can_vxworks.c	VxWorks based on device driver
can_xilinx_xcan.c  Xilinx XCAN
can_xzync_qnx.c  Xilinx XZYNC with QNX Posix interface

reduncy.c	additional functions for redundancy support

